{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=1 portless run next dev",
    "dev:tailscale": "PORTLESS_PORT=1355 PORTLESS_HTTPS=1 portless my-website --tailscale next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "sanity:typegen": "$HOME/.nvm/versions/node/v24.9.0/bin/node node_modules/sanity/bin/sanity schema extract --force && $HOME/.nvm/versions/node/v24.9.0/bin/node node_modules/sanity/bin/sanity typegen generate",
    "sanity:seed": "$HOME/.nvm/versions/node/v24.9.0/bin/node node_modules/sanity/bin/sanity exec"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-sanity": "^13.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.9.1",
    "shadcn": "^4.16.1",
    "styled-components": "^6.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
